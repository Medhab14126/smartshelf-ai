# ---------------------------------------------------------------------------
# SmartShelf AI configuration. Copy to `.env` and adjust. Never commit `.env`.
# ---------------------------------------------------------------------------

# --- General ---
ENVIRONMENT=development
LOG_LEVEL=INFO
# Public URL of the frontend (used for links in emails)
FRONTEND_BASE_URL=http://localhost:8080
# Comma-separated list of allowed browser origins
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- PostgreSQL ---
POSTGRES_USER=smartshelf
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=smartshelf
# Used by the backend. Inside Docker Compose the host is `db`.
DATABASE_URL=postgresql+psycopg://smartshelf:change-me-local-only@localhost:5432/smartshelf

# --- Sessions ---
SESSION_TTL_HOURS=168
# Set to true when serving over HTTPS
SESSION_COOKIE_SECURE=false

# --- Uploads ---
UPLOAD_DIR=./data/uploads
MAX_UPLOAD_MB=15
MAX_PDF_PAGES=20

# --- OCR: auto | tesseract | paddle ---
OCR_ENGINE=auto
TESSERACT_LANG=eng

# --- Local LLM via Ollama (optional; the app works without it) ---
# Makes `docker compose up` also start the bundled Ollama container (the "ai" profile).
# COMPOSE_PROFILES=ai
LLM_ENABLED=true
# Docker Compose (ai profile): http://ollama:11434 ; Ollama on the host: http://host.docker.internal:11434
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
# Optional vision-language model for packaging photos, e.g. qwen2.5vl:7b (leave empty to disable)
OLLAMA_VISION_MODEL=
LLM_TIMEOUT_SECONDS=120
LLM_MAX_ATTEMPTS=2

# --- Background jobs ---
RUN_SCHEDULER=true
EXPIRY_CHECK_INTERVAL_MINUTES=15
NOTIFICATION_DISPATCH_INTERVAL_SECONDS=60

# --- Email (Mailpit locally: host=localhost or `mailpit` in Docker, port 1025) ---
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_USE_SSL=false
EMAIL_FROM=SmartShelf AI <alerts@smartshelf.local>
EMAIL_MAX_ATTEMPTS=5
